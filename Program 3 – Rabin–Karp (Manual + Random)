import time
import random
import string


def rabin_karp(text,
               pattern,
               d=256,
               q=101):

    n=len(text)

    m=len(pattern)

    h=pow(d,m-1)%q

    p=0

    t=0

    result=[]


    for i in range(m):

        p=(d*p+
           ord(pattern[i]))%q

        t=(d*t+
           ord(text[i]))%q



    for s in range(
            n-m+1):

        if p==t:

            if text[s:s+m]==pattern:

                result.append(s)

        if s<n-m:

            t=(d*
               (t-
                ord(text[s])*h)

               +ord(text[s+m]))%q

            if t<0:

                t+=q

    return result



print("1 - Manual Input")

print("2 - Random Generation")

choice=int(input(
    "Choice: "))


if choice==1:

    text=input(
        "Enter text: ")

    pattern=input(
        "Enter pattern: ")

else:

    length=int(
        input(
            "Text length: "))

    pattern_len=int(
        input(
            "Pattern length: "))

    text=''.join(
        random.choice(
            string.ascii_lowercase)

        for _ in range(length))

    start=random.randint(
        0,
        length-pattern_len)

    pattern=text[
        start:
        start+pattern_len]

    print(
        "Generated text:")

    print(text)

    print(
        "Generated pattern:")

    print(pattern)



stime=time.time()

result=rabin_karp(
    text,
    pattern)

etime=time.time()

print(
    "Match positions:",
    result)

print(
    "Execution time:",
    etime-stime)
