# ══════════════════════════════════════════════════
# FILE READERS
# ══════════════════════════════════════════════════

def read_txt(path):
    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
        return f.read()

def read_pdf(path):
    text = ''
    with open(path, 'rb') as f:
        reader = PyPDF2.PdfReader(f)
        for page in reader.pages:
            t = page.extract_text()
            if t:
                text += t + '\n'
    return text

def read_docx(path):
    doc = Document(path)
    return '\n'.join(p.text for p in doc.paragraphs)

def load_document(path):
    ext = os.path.splitext(path)[1].lower()
    loaders = {'.txt': read_txt, '.pdf': read_pdf, '.docx': read_docx}
    return loaders.get(ext, lambda p: '')(path)


# ══════════════════════════════════════════════════
# SEARCH ALGORITHMS  (used for benchmark timing)
# ══════════════════════════════════════════════════

def naive_search(text, pattern):
    """Brute-force O(n·m) search — returns all match positions."""
    positions, n, m = [], len(text), len(pattern)
    for i in range(n - m + 1):
        if text[i:i+m] == pattern:
            positions.append(i)
    return positions

def compute_lps(pattern):
    """KMP failure / longest-proper-prefix-suffix array."""
    lps = [0] * len(pattern)
    length, i = 0, 1
    while i < len(pattern):
        if pattern[i] == pattern[length]:
            length += 1; lps[i] = length; i += 1
        elif length:
            length = lps[length - 1]
        else:
            i += 1
    return lps

def kmp_search(text, pattern):
    """Knuth-Morris-Pratt O(n+m) search."""
    if not pattern:
        return []
    positions, lps = [], compute_lps(pattern)
    i = j = 0
    while i < len(text):
        if pattern[j] == text[i]:
            i += 1; j += 1
        if j == len(pattern):
            positions.append(i - j); j = lps[j - 1]
        elif i < len(text):
            if j:
                j = lps[j - 1]
            else:
                i += 1
    return positions

def rabin_karp_search(text, pattern, d=256, q=101):
    """Rabin-Karp rolling-hash O(n+m) average search."""
    positions, n, m = [], len(text), len(pattern)
    if m > n:
        return positions
    h = pow(d, m - 1, q)
    p = t = 0
    for i in range(m):
        p = (d * p + ord(pattern[i])) % q
        t = (d * t + ord(text[i]))   % q
    for s in range(n - m + 1):
        if p == t and text[s:s+m] == pattern:
            positions.append(s)
        if s < n - m:
            t = (d * (t - ord(text[s]) * h) + ord(text[s + m])) % q
            if t < 0:
                t += q
    return positions


# ══════════════════════════════════════════════════
# TEXT HELPERS
# ══════════════════════════════════════════════════

def tokenize(text, min_len=4):
    """Extract lowercase alphabetic words of at least min_len characters."""
    return [w for w in re.findall(r'\b[a-z]{4,}\b', text.lower())
            if len(w) >= min_len]

def extract_phrases(words, n=3):
    """Return list of n-gram phrase strings from a word list."""
    return [' '.join(words[i:i+n]) for i in range(len(words) - n + 1)]


# ══════════════════════════════════════════════════
# FAST COMPARISON ENGINE
# ══════════════════════════════════════════════════

def run_comparison(text1, text2, algo='kmp', min_len=4):
    """
    Compare two documents and return a full result dict.

    Speed strategy:
    - Similarity metrics use set/Counter operations (instant).
    - Algorithm timing uses a benchmark sample of 50 words so
      Naive / KMP / Rabin-Karp times are shown fairly without
      taking minutes on large documents.
    """
    t1 = text1.lower()
    t2 = text2.lower()

    words1_all = tokenize(t1, min_len)
    words2_all = tokenize(t2, min_len)

    set1 = set(words1_all)
    set2 = set(words2_all)

    # ── Fast similarity metrics (set / sequence ops) ─────────────────────────
    matched_words  = sorted(set1 & set2)           # instant set intersection
    word_sim       = len(matched_words) / max(len(set1), 1) * 100

    # Character-level on first 8 000 chars each (enough signal, stays fast)
    char_sim       = SequenceMatcher(None, t1[:8000], t2[:8000]).ratio() * 100

    # 3-gram phrase overlap using sets
    phrases1       = set(extract_phrases(words1_all))
    phrases2       = set(extract_phrases(words2_all))
    shared_phrases = sorted(phrases1 & phrases2)
    phrase_sim     = len(shared_phrases) / max(len(phrases1), 1) * 100

    combined       = 0.40 * word_sim + 0.35 * char_sim + 0.25 * phrase_sim

    # ── Algorithm benchmark on a 50-word sample ──────────────────────────────
    # We pick 50 words spread across the matched set so every algo gets
    # a fair, representative workload — results are proportional to full run.
    sample_size = min(50, len(matched_words))
    step        = max(1, len(matched_words) // sample_size)
    sample      = matched_words[::step][:sample_size]

    # Use a 20 000-char slice of doc2 as the search target for benchmarking
    bench_text  = t2[:20000]

    search_fns  = {
        'naive': naive_search,
        'kmp':   kmp_search,
        'rabin': rabin_karp_search,
    }
    timings = {}
    for name, fn in search_fns.items():
        t0 = time.perf_counter()
        for word in sample:
            fn(bench_text, word)
        # Scale timing to what full run would approximately take
        scale = max(len(matched_words), 1) / max(sample_size, 1)
        timings[name] = (time.perf_counter() - t0) * scale

    # ── Top matched words by frequency in doc2 ────────────────────────────────
    freq2       = Counter(words2_all)
    top_matches = sorted(
        [(w, freq2[w]) for w in matched_words if freq2[w] > 0],
        key=lambda x: -x[1]
    )

    return {
        'word_sim':        word_sim,
        'char_sim':        char_sim,
        'phrase_sim':      phrase_sim,
        'combined':        combined,
        'matched_words':   matched_words,
        'top_matches':     top_matches[:20],
        'shared_phrases':  shared_phrases[:15],
        'timings':         timings,
        'words1_count':    len(set1),
        'words2_count':    len(set2),
        'text1_len':       len(text1),
        'text2_len':       len(text2),
    }

