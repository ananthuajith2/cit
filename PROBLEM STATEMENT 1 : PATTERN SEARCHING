                f'<td style="padding:6px 14px;text-align:center;color:#1a7f37;font-weight:bold;">{result["char_sim"]:.1f}%</td>'
                f'<td style="padding:6px 14px;color:#57606a;">Sequence-level match</td></tr>'
                f'<tr><td style="padding:6px 14px;">Phrase Similarity</td>'
                f'<td style="padding:6px 14px;text-align:center;color:#9a6700;font-weight:bold;">{result["phrase_sim"]:.1f}%</td>'
                f'<td style="padding:6px 14px;color:#57606a;">3-gram phrase overlap</td></tr>'
                f'<tr style="border-top:1px solid #30363d;">'
                f'<td style="padding:8px 14px;font-weight:bold;">Combined Score</td>'
                f'<td style="padding:8px 14px;text-align:center;color:{col};font-weight:bold;font-size:16px;">{result["combined"]:.1f}%</td>'
                f'<td style="padding:8px 14px;color:#57606a;">40% word + 35% char + 25% phrase</td></tr>'
                '</table>'
                '<hr style="border-color:#30363d;margin:14px 0;">'
                '<div style="display:flex;gap:36px;">'
                f'<span>Naive:&nbsp;<b style="color:#9a6700;">{result["timings"]["naive"]:.4f}s</b></span>'
                f'<span>KMP:&nbsp;<b style="color:#0969da;">{result["timings"]["kmp"]:.4f}s</b></span>'
                f'<span>Rabin-Karp:&nbsp;<b style="color:#1a7f37;">{result["timings"]["rabin"]:.4f}s</b></span>'
                f'<span style="color:#57606a;">| Matched: <b style="color:#1f2328;">{len(result["matched_words"])}</b>'
                f' words &nbsp;| Phrases: <b style="color:#1f2328;">{len(result["shared_phrases"])}</b></span>'
                '</div></div>'
            ))
            plot_results(result, state['name1'], state['name2'])

        with phrase_out:
            if result['shared_phrases']:
                rows = ''.join(
                    f'<tr><td style="padding:5px 12px;border-bottom:1px solid #30363d;">{i+1}</td>'
                    f'<td style="padding:5px 12px;border-bottom:1px solid #30363d;color:#1f2328;">{ph}</td></tr>'
                    for i, ph in enumerate(result['shared_phrases'])
                )
                display(HTML(
                    '<div style="background:#f6f8fa;border:1px solid #d0d7de;'
                    'border-radius:10px;padding:16px;font-family:monospace;margin-top:12px;">'
                    '<h4 style="color:#0969da;margin:0 0 12px;">Shared 3-Word Phrases (top 15)</h4>'
                    '<table style="width:100%;">'
                    '<tr style="color:#57606a;border-bottom:1px solid #30363d;">'
                    '<th style="text-align:left;padding:4px 12px;">#</th>'
                    '<th style="text-align:left;padding:4px 12px;">Phrase</th></tr>'
                    + rows + '</table></div>'
                ))
        progress.value = 100

    except Exception as e:
        with out:
            display(HTML(
                '<div style="background:#fff5f5;border:1px solid #cf222e;'
                f'border-radius:8px;padding:12px;font-family:monospace;">'
                f'<b style="color:#cf222e;">Error:</b> <span style="color:#1f2328;">{e}</span></div>'
            ))
    finally:
        progress.layout.visibility = 'hidden'


def on_export(b):
    if not state['result']:
        with out:
            display(HTML('<p style="color:#cf222e;font-family:monospace;">Run a comparison first.</p>'))
        return
    r = state['result']
    lines = [
        '=' * 60, 'PLAGIARISM DETECTION REPORT', '=' * 60,
        f"Document 1 : {state['name1']}", f"Document 2 : {state['name2']}", '',
        f"Word Similarity   : {r['word_sim']:.2f}%",
        f"Char Similarity   : {r['char_sim']:.2f}%",
        f"Phrase Similarity : {r['phrase_sim']:.2f}%",
        f"Combined Score    : {r['combined']:.2f}%",
        f"Risk Level        : {risk_label(r['combined'])[0]}", '',
        f"Naive time    : {r['timings']['naive']:.4f}s",
        f"KMP time      : {r['timings']['kmp']:.4f}s",
        f"Rabin time    : {r['timings']['rabin']:.4f}s", '',
        'TOP MATCHED WORDS:', *[f"  {w} ({f}x)" for w, f in r['top_matches']], '',
        'SHARED PHRASES:',   *[f"  {p}" for p in r['shared_phrases']], '=' * 60,
    ]
    report_text = '\n'.join(lines)
    import tempfile as _tf
    out_path = _tf.gettempdir().replace('\\\\','/') + '/plagiarism_report.txt'
    with open(out_path, 'w') as f:
        f.write(report_text)
    with out:
        display(HTML(f'<p style="color:#1a7f37;font-family:monospace;">Saved to <code>{out_path}</code></p>'))
        display(HTML(f'<pre style="color:#1f2328;background:#f6f8fa;padding:12px;border-radius:8px;font-size:12px;">{report_text}</pre>'))


