# ── Core helper: extract bytes from FileUpload regardless of ipywidgets version ──
def _get_upload_bytes(uploader):
    """Works with ipywidgets 7.x (dict) and 8.x (tuple of dicts)."""
    val = uploader.value
    if not val:
        return None, None
    if isinstance(val, dict):           # v7: {filename: {content:..., ...}}
        name    = list(val.keys())[0]
        content = bytes(val[name]['content'])
    else:                               # v8: tuple/list of {'name':..,'content':..}
        item    = val[0] if isinstance(val, (list, tuple)) else list(val.values())[0]
        name    = item.get('name', 'file')
        content = bytes(item['content'])
    return name, content


def _ingest(uploader, slot):
    """Save upload bytes to a temp file, load text, update state."""
    name, content = _get_upload_bytes(uploader)
    if name is None:
        return False
    ext = os.path.splitext(name)[1].lower()
    suffix = ext if ext in ('.txt', '.pdf', '.docx') else '.tmp'
    tmp = tempfile.mktemp(suffix=suffix)
    try:
        with open(tmp, 'wb') as f:
            f.write(content)
        text = load_document(tmp)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)
    state[f'text{slot}'] = text
    state[f'name{slot}'] = name
    badge = (
        '<span style="color:#1a7f37;font-family:monospace;font-size:12px;">'
        f'&#10003; {name} &nbsp;({len(text):,} chars)</span>'
    )
    if slot == 1:
        status1.value = badge
    else:
        status2.value = badge
    return True


